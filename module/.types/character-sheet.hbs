<section class="document-layout character-sheet">
  <header class="character-hero">
    <tarp-image field="image" image-aspect="2:3"></tarp-image>
    <div class="character-identity">
      <h2 class="character-name" title="{{description}}">{{name}}</h2>
      <div class="sheet-attributes">
        <div class="attribute" tabindex="0" aria-describedby="attribute-limit-1"><span class="attribute-label">力量</span><strong class="attribute-value">{{field "attributes.strength"}}</strong><span class="stat-tooltip" role="tooltip" id="attribute-limit-1">上限 {{field "max_attributes.strength"}}</span></div>
        <div class="attribute" tabindex="0" aria-describedby="attribute-limit-2"><span class="attribute-label">敏捷</span><strong class="attribute-value">{{field "attributes.dexterity"}}</strong><span class="stat-tooltip" role="tooltip" id="attribute-limit-2">上限 {{field "max_attributes.dexterity"}}</span></div>
        <div class="attribute" tabindex="0" aria-describedby="attribute-limit-3"><span class="attribute-label">意志</span><strong class="attribute-value">{{field "attributes.willpower"}}</strong><span class="stat-tooltip" role="tooltip" id="attribute-limit-3">上限 {{field "max_attributes.willpower"}}</span></div>
        <div class="attribute"><span class="attribute-label">护甲</span><strong class="attribute-value">{{field "armor"}}</strong></div>
      </div>
    </div>
  </header>
  <div class="vitality"><div class="resource-block"><div class="section-heading"><span>体力</span><strong>{{field "hp"}} <span class="secondary">/ {{field "max_hp"}}</span></strong></div>{{#unless (lookup errors "hp")}}{{#unless (lookup errors "max_hp")}}{{#if values.max_hp}}<meter class="hp-meter" min="0" max="{{values.max_hp}}" value="{{values.hp}}" aria-label="体力"></meter>{{/if}}{{/unless}}{{/unless}}</div></div>
  {{#if values.injury.state}}<p class="injury-notice">重伤状态：{{values.injury.state}}</p>{{/if}}
  {{#if values.effects.length}}<ul class="effect-list">{{#each values.effects}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
  <div class="condition-list">
    {{#if values.overburdened}}<span class="condition">满载，体力为 0</span>{{/if}}
    {{#if values.deprived}}<span class="condition">匮乏</span>{{/if}}
    {{#if values.hungry}}<span class="condition">饥饿</span>{{/if}}
    {{#if values.sleep_deprived}}<span class="condition">缺乏睡眠</span>{{/if}}
  </div>
  {{#if values.scars.length}}
    <details class="scars"><summary>伤疤记录</summary>{{#if values.scars.length}}<div class="scar-list">{{#each values.scars}}
<article class="scar-record"><div class="section-heading"><strong>伤疤 · {{damage}}</strong><span>{{#if resolved}}已恢复／消耗{{else}}尚未恢复{{/if}}</span></div><p>{{description}}</p><p class="secondary">恢复条件：{{recovery}}</p></article>
{{/each}}</div>{{/if}}</details>
  {{/if}}
  <section class="inventory-section">
    <div class="section-heading"><h3>行装</h3><span>{{display.packSummary}}</span></div>
    <tarp-item-grid field="equipment" reference-field="item" quantity-field="quantity" capacity="10" label="行装"></tarp-item-grid>
  </section>
</section>
